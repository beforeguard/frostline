<Project>
  <PropertyGroup>
    <!-- Version managed by versionize via git tags -->
    <!-- For local builds without tags, fallback to 0.1.0-dev -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' AND '$(Configuration)' == 'Debug'">dev</VersionSuffix>
    
    <!-- Package Metadata -->
    <Authors>Brian Egan (Beforeguard)</Authors>
    <Company>Beforeguard</Company>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) Beforeguard</Copyright>
    
    <!-- URLs -->
    <PackageProjectUrl>https://github.com/Beforeguard/Frostline</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Beforeguard/Frostline</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    
    <!-- Tags & Classification -->
    <PackageTags>fsharp;battlenet;blizzard;worldofwarcraft;wow;api;sdk</PackageTags>
    
    <!-- Build Settings -->
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    
    <!-- Source Link & Deterministic Builds (CI) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Source Link support for debugging -->
  <ItemGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
  </ItemGroup>
</Project>