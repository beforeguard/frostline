<Project>
  <PropertyGroup>
    <!-- Version managed by versionize -->
    <Version>0.2.0</Version>
    
    <!-- Package Metadata -->
    <Authors>Brian Egan (Beforeguard)</Authors>
    <Company>Beforeguard</Company>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) Beforeguard</Copyright>
    
    <!-- URLs -->
    <PackageProjectUrl>https://github.com/Beforeguard/Frostline</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Beforeguard/Frostline</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    
    <!-- Package Icon -->
    <PackageIcon>frostline_icon.png</PackageIcon>
    
    <!-- Tags & Classification -->
    <PackageTags>fsharp;battlenet;blizzard;worldofwarcraft;wow;api;sdk</PackageTags>
    
    <!-- Build Settings -->
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    
    <!-- Source Link & Deterministic Builds (CI) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Source Link support for debugging -->
  <ItemGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Include package icon -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)frostline_icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>