<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package-specific metadata -->
    <PackageId>Beforeguard.Frostline.Core</PackageId>
    <Description>Core authentication and HTTP infrastructure for the Frostline Battle.net SDK. Provides OAuth 2.0 client credentials flow, token management, and multi-region API access with Result-based error handling.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FrostlineError.fs" />
    <Compile Include="Region.fs" />
    <Compile Include="ClientConfig.fs" />
    <Compile Include="TokenManager.fs" />
    <Compile Include="BattleNetHttpClient.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

</Project>
